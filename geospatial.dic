## Coordinate systems and geospatial tooling
#

# EPSG coordinate-reference-system authority code.
EPSG
# EPSG coordinate-reference-system authority code.
epsg
# Geospatial Data Abstraction Library.
GDAL
# Python library for geospatial vector data.
geopandas
# Python library for STAC catalogs.
pystac
# Python library for geospatial raster I/O.
rasterio
# Repartitioning array chunks for parallel processing.
rechunking
# xarray extension for raster and coordinate-reference operations.
rioxarray
# Uppercase SpatioTemporal Asset Catalog acronym.
STAC
# SpatioTemporal Asset Catalog standard.
stac
# Library for stacking STAC assets into xarray data.
stackstac


# EditorConfig policy: it sets indentation for new text and never rewrites
# existing bytes. Two spaces is the measured modal width — shell, CSS, HTML,
# YAML, JSON, D2 and markdown.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# Python is four by PEP 8 and `indent-width`; the recipe, build-step and ini
# bodies are four here, and `just` cannot parse a recipe mixing two and four.
[{*.ini,*.just,*.py,Dockerfile,justfile}]
indent_size = 4

# Preserves intentional hard breaks (two trailing spaces).
[*.md]
trim_trailing_whitespace = false

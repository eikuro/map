#
##   Blacklist
#

## Global Conventions
# > a leading dot and a leading underscore are ignored everywhere
.*
_*

## common build, test, packaging root output
/build/
/Formula/
/coverage/
/dist/
/out/
/releases/
/report/

## root runtime output
# > ignore all root cache dir, e.g. ruff_cache
# > ignore the shared storage mount, which holds data outside the repository
# > keep the output directory but not its content; `.gitkeep` is what keeps the
# > directory itself in the repository
/*cache*/
/log/
/logs/
/output/*
!/output/.gitkeep
/storage

## tooling output root dir
/temp/
/tmp/

## tooling output files
# > D2 twins are local render aids; the committed artefact is the D2 source
*.log
**/graph/**/*.html
**/graph/**/*.svg

## consumer config symlinks
# > repositories that own real copies re-include them in Repo-specific Entries
/cspell.config.yaml
/justfile

## consumer agent symlinks
# > .* symlinks already ignored
/AGENTS.md
/.github/agents
/.github/copilot-instructions.md
harnesses/claude/skills

#
##   Whitelist
#

## Global Exceptions
# allow __ module paths (e.g. __init__.py, __tests__/, __fixtures__/); a single
# _ stays ignored
!__*.*
!__*/

## Git metadata files
# > explicit names keep .git and .github ignored by file walkers too
!.gitattributes
!.gitignore
!.gitkeep

## repository metadata
# > a trailing / allows real directories; Git still ignores symlinks, and the
# > agent links inside `.github` stay ignored through the managed block Porter
# > appends, so only the real workflow files become trackable
!/.github/

## agent and editor discovery
# > a trailing / allows real directories; Git still ignores symlinks
!/.agents/
!/.vscode/

#
## Exceptions for Whitelist
#

# re-enable .* in .agents/ after whitelist
.agents/**/.*


#
##   Repo-specific Entries
#

## track real config files
!/.editorconfig
!/.markdownlint.yaml
!/.pre-commit-config.yaml
!/cspell.config.yaml

# EditorConfig is the shared indentation policy: an editor or format tool reads
# it while editing, and nothing rewrites existing bytes. The widths here were
# measured across the workspace's tracked files — two spaces is the modal width
# for shell, CSS, HTML, YAML, JSON, D2 and markdown, while Python (PEP 8), INI,
# justfile and Dockerfile are four.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[{Dockerfile,justfile,*.ini,*.just}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
